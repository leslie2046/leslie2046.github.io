---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate } from '../lib/posts';
import PostList from '../components/PostList.astro';
const posts = (await getPosts()).filter(post => post.data.section === 'tech');
const articles = posts.filter(post => post.data.kind === 'article');
const reports = posts.filter(post => post.data.kind === 'report');
---
<Base appearance="engineering">
  <div id="top" class="shell engineering-home">
    <section class="engineering-intro">
      <h1>Leslie 的工程笔记：<br />把系统构建得更可靠。</h1>
      <div class="engineering-actions"><a href="https://github.com/leslie2046">GitHub ↗</a></div>
    </section>
    <PostList posts={articles} heading="工程文章" layout="engineering" />
    {reports.length > 0 && <section class="reports-module" aria-labelledby="reports-title">
      <div class="reports-heading"><h2 id="reports-title">技术报告 <span>{String(reports.length).padStart(2, '0')}</span></h2><a href="/reports/">查看全部报告 ↗</a></div>
      <p>性能测试、部署对比与数据分析。保留测试条件、关键结果和结论边界。</p>
      <div class="report-rows">{reports.slice(0, 3).map(report => <article><h3><a href={`/posts/${report.id}/`}>{report.data.title}</a></h3><time datetime={report.data.date.toISOString()}>{formatDate(report.data.date)}</time></article>)}</div>
    </section>}
    <aside class="engineering-note"><h2>在实践中思考，<br />在记录中成长。</h2><div><p>关于 AI 应用、开源贡献和软件工程。<br />记录问题，也记录解决问题的过程。</p><a href="/about/">关于 Leslie ↗</a></div></aside>
  </div>

</Base>
