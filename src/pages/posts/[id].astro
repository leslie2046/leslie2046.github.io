---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HealthDashboard from '../../components/HealthDashboard.astro';
import { getPosts, formatDate, readingTime } from '../../lib/posts';
export async function getStaticPaths() { return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<Base title={`${post.data.title} · Leslie`} description={post.data.description} image={post.data.cover} appearance={post.data.section === 'tech' ? 'engineering' : 'journal'}>
  <div id="top" class="shell article-shell">
    <a class="back-link" href={post.data.section === 'life' ? '/life/' : post.data.kind === 'report' ? '/reports/' : '/'}>{post.data.section === 'life' ? '← 生活片段' : post.data.kind === 'report' ? '← 技术报告' : '← 所有文章'}</a>
    {post.data.section === 'tech' ? <header class="engineering-article-header">
      <div class="article-kicker">{post.data.kind === 'report' && '技术报告 · '}{post.data.category}</div>
      <h1>{post.data.title}</h1>
      <div class="article-overview">
        <div class="article-publication"><span>发布于</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>Leslie · {readingTime(post.body)} 分钟阅读</span></div>
        <div class="article-deck"><p>{post.data.description}</p><div class="tags flex flex-wrap gap-4">{post.data.tags.map(tag => <span>#{tag}</span>)}</div></div>
      </div>
    </header> : <header class="article-header"><div class="post-meta"><span class="accent">{post.data.category}</span><span> / </span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>· {readingTime(post.body)} 分钟阅读</span></div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tags flex gap-4">{post.data.tags.map(tag => <span>#{tag}</span>)}</div></header>}
    <div class="article-grid">
      <article class="prose"><Content />{post.id === 'blood-pressure-medication-day-1' && <HealthDashboard />}{(post.data.source || post.data.references || post.data.download) && <div class="article-source"><strong>相关资料</strong><p>{post.data.source && <a href={post.data.source}>相关资料 ↗</a>}{post.data.references && <>{post.data.source && <span> · </span>}<a href={post.data.references}>事实核对记录 ↗</a></>}</p>{post.data.download && <p><a href={post.data.download} download>下载本文 Markdown ↓</a></p>}</div>}</article>
      <aside class="toc"><details open><summary>文章目录</summary><nav aria-label="文章目录"><ol>{toc.map(h => <li class:list={{sub: h.depth === 3}}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details></aside>
    </div>
  </div>
  <script>
    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach(pre => {
      const code = pre.querySelector('code');
      if (!code) return;
      const button = document.createElement('button');
      button.textContent = '复制'; button.className = 'copy-button'; button.setAttribute('aria-label', '复制代码');
      button.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(code.textContent || ''); button.textContent = '已复制'; }
        catch { button.textContent = '复制失败'; }
        window.setTimeout(() => button.textContent = '复制', 2000);
      });
      pre.append(button);
    });
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => { if (entry.isIntersecting) links.forEach(link => link.classList.toggle('current', decodeURIComponent(link.hash.slice(1)) === entry.target.id)); });
    }, { rootMargin: '-10% 0px -70% 0px' });
    document.querySelectorAll('.prose h2, .prose h3').forEach(heading => observer.observe(heading));
  </script>
</Base>
