---
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';
import PostList from '../components/PostList.astro';
const posts = (await getPosts()).filter(post => post.data.section === 'tech');
---
<Base>
  <div id="top" class="shell">
    <section class="hero">
      <div class="eyebrow"><span class="small-dot"></span> LESLIE'S ENGINEERING JOURNAL</div>
      <h1>技术，实践，<br /><span>以及一点思考。</span></h1>
      <div class="hero-bottom flex flex-wrap items-end justify-between gap-6">
        <p>把复杂的问题想清楚，把有用的经验写下来。<br />这里记录 AI、开源与软件工程中的探索。</p>
        <a class="text-link" href="/about/">认识一下 Leslie <span>↗</span></a>
      </div>
    </section>
    <PostList posts={posts} />
    <aside class="about-strip flex flex-wrap justify-between items-center gap-6"><div><span class="eyebrow">ABOUT THE AUTHOR</span><h2>你好，我是 Leslie。</h2><p>关注 AI 应用、开源贡献与工程性能。用代码解决问题，用文字留下过程。</p></div><a class="round-link" href="https://github.com/leslie2046" aria-label="访问 Leslie 的 GitHub">↗</a></aside>
  </div>

</Base>
