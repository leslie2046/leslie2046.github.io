---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/posts';
interface Props { posts: CollectionEntry<'posts'>[]; heading?: string; }
const { posts, heading = '最新文章' } = Astro.props;
const categories = [...new Set(posts.map(p => p.data.category))];
---
    <section class="journal" aria-labelledby="journal-title">
      <div class="section-heading flex flex-wrap justify-between items-center gap-6">
        <h2 id="journal-title">{heading} <span>{String(posts.length).padStart(2, '0')}</span></h2>
        <label class="search-box"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="search" type="search" placeholder="搜索文章、标签…" aria-label="搜索文章" /></label>
      </div>
      <div class="filters flex flex-wrap gap-2" role="group" aria-label="文章分类">
        <button class="filter active" data-category="all" aria-pressed="true">全部文章</button>
        {categories.map(category => <button class="filter" data-category={category} aria-pressed="false">{category}</button>)}
      </div>
      <div id="post-list">
        {posts.map((post, index) => <article class:list={["post-card", { "no-cover": !post.data.cover }]} data-category={post.data.category} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${post.body || ''}`.toLowerCase()}>
          <div class="post-copy">
            <div class="post-meta"><span class="accent">{post.data.category}</span><span> / </span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>· {readingTime(post.body)} 分钟阅读</span></div>
            <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <div class="flex flex-wrap items-center gap-3 tags">{post.data.tags.map(tag => <span>#{tag}</span>)}</div>
            <a class="read-link" href={`/posts/${post.id}/`}>阅读全文 <span>↗</span><span class="sr-only">：{post.data.title}</span></a>
          </div>
          {post.data.cover && <a class="post-cover" href={`/posts/${post.id}/`} tabindex="-1" aria-hidden="true"><img src={post.data.cover} alt="" width="1536" height="1024" loading={index === 0 ? 'eager' : 'lazy'} /></a>}
        </article>)}
      </div>
      <p id="empty-state" class="empty-state" hidden>没有找到匹配的文章，试试其他关键词。</p>
      <p id="result-count" class="sr-only" aria-live="polite"></p>
      <div class="journal-end"><span></span><p>持续记录，慢慢积累。</p><span></span></div>
    </section>
  <script>
    const search = document.querySelector<HTMLInputElement>('#search');
    const cards = [...document.querySelectorAll<HTMLElement>('.post-card')];
    const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    let category = 'all';
    function filterPosts() {
      const query = search?.value.trim().toLowerCase() || '';
      let count = 0;
      cards.forEach(card => {
        const visible = (category === 'all' || card.dataset.category === category) && (card.dataset.search || '').includes(query);
        card.hidden = !visible;
        if (visible) count++;
      });
      const empty = document.querySelector<HTMLElement>('#empty-state');
      if (empty) empty.hidden = count > 0;
      const results = document.querySelector('#result-count');
      if (results) results.textContent = `找到 ${count} 篇文章`;
    }
    search?.addEventListener('input', filterPosts);
    filters.forEach(button => button.addEventListener('click', () => {
      category = button.dataset.category || 'all';
      filters.forEach(item => { item.classList.toggle('active', item === button); item.setAttribute('aria-pressed', String(item === button)); });
      filterPosts();
    }));
  </script>
